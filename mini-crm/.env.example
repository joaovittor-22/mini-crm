APP_NAME="Mini CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Driver de log - usamos stack para gravar tanto no laravel.log quanto no contact.log
LOG_CHANNEL=stack
LOG_STACK=single,contact
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mini_crm
DB_USERNAME=mini_crm
DB_PASSWORD=secret

# Configurações do banco de testes (usado pelo phpunit.xml)
DB_TEST_HOST=mysql_test
DB_TEST_PORT=3306
DB_TEST_DATABASE=mini_crm_test
DB_TEST_USERNAME=mini_crm
DB_TEST_PASSWORD=secret

# Redis é usado tanto para filas quanto para cache e broadcast
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuração do Laravel Reverb (WebSockets)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=mini-crm-app
REVERB_APP_KEY=mini-crm-key
REVERB_APP_SECRET=mini-crm-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Variáveis expostas ao frontend (Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
